{
  "manifest_version": 3,
  "name": "Figma Analytics Export",
  "version": "1.6.8",
  "description": "Export Library Analytics data from Figma to CSV, JSON, and Markdown. Formerly Figma UI Mod.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.figma.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Figma Analytics Export"
  },
  "content_scripts": [
    {
      "matches": ["https://*.figma.com/*", "https://figma.com/*"],
      "js": ["scraper.js", "content/launcher.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "favicon_16.png",
    "32": "favicon_32.png",
    "48": "favicon_48.png",
    "128": "favicon_128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["favicon_16.png", "favicon_32.png", "favicon_48.png"],
      "matches": ["https://*.figma.com/*", "https://figma.com/*"]
    }
  ]
}
